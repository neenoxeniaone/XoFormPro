<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom web.config kept by `dotnet publish` (the SDK only updates the <aspNetCore> path/args).
  The WebDAV module/handler are removed so PUT / DELETE / PATCH requests reach the API instead
  of being rejected by IIS with HTTP 405.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\FormSubmissionPro.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <!--
          Host configuration. Double underscore = nesting, so Jwt__SigningKey binds to the
          Jwt:SigningKey setting. The app refuses to start without a signing key outside
          Development (see Program.cs) rather than falling back to the committed dev key.

          NOTE: never put secrets here - this file is committed. Jwt:SigningKey and the
          connection string come from appsettings.Production.json (git-ignored, published
          with the app) or from environment variables on the server.
        -->
        <environmentVariables>
          <environmentVariable name="App__BaseUrl" value="https://xoformpro.xeniaone.com" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
